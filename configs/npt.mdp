; Define preprocessor options
define                  = -DPOSRES  ; Keep solute position restrained

; Run control
integrator              = md        ; Leap-frog integrator
nsteps                  = 50000     ; 2 * 50000 = 100 ps
dt                      = 0.002     ; 2 fs step size

; Output control
nstxout                 = 500       ; save coordinates every 1.0 ps
nstvout                 = 500       ; save velocities every 1.0 ps
nstenergy               = 500       ; save energies every 1.0 ps
nstlog                  = 500       ; update log file every 1.0 ps

; Bond dynamics
continuation            = yes       ; Restarting from NVT, so continuation is YES
constraint_algorithm    = lincs     ; holonomic constraints 
constraints             = h-bonds   ; constrain bonds involving Hydrogen
lincs_iter              = 1         ; accuracy of LINCS
lincs_order             = 4         ; also related to accuracy

; Neighbor searching and Nonbonded interactions
cutoff-scheme           = Verlet    ; Buffered neighbor searching
nstlist                 = 10        ; 20 fs frequency to update neighbor list
rcoulomb                = 1.0       ; Short-range electrostatic cutoff (nm)
rvdw                    = 1.0       ; Short-range Van der Waals cutoff (nm)
DispCorr                = EnerPres  ; Account for long-range VdW corrections

; Electrostatics
coulombtype             = PME       ; Particle Mesh Ewald
pme_order               = 4         ; cubic interpolation
fourierspacing          = 0.16      ; grid spacing for FFT

; Temperature coupling is ON
tcoupl                  = V-rescale             ; Modified Berendsen thermostat
tc-grps                 = Protein Non-Protein   ; Two coupling groups
tau_t                   = 0.1     0.1           ; Time constant (ps)
ref_t                   = 300     300           ; Target temperature (K)

; Pressure coupling is ON for NPT
pcoupl                  = C-rescale             ; Calandrini-rescale barostat
pcoupltype              = isotropic             ; Uniform expansion/contraction
tau_p                   = 2.0                   ; Time constant (ps)
ref_p                   = 1.0                   ; Target pressure (bar)
compressibility         = 4.5e-5                ; Compressibility of water (bar^-1)
refcoord_scaling        = com

; Velocity generation
gen_vel                 = no        ; Velocities are carried over from NVT